@id("read-research") permit (principal, action in [Jans::Action::"Search", Jans::Action::"Read"], resource) when { context has tokens && context.tokens has jans_access_token && context.tokens.jans_access_token has scp && context.tokens.jans_access_token.scp.contains("research:read") && context.tokens.jans_access_token has aud && context.tokens.jans_access_token.aud.contains("ledgerline-research") };